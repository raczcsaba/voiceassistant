<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="hu.csabi.adbkeeper">
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 14+ refuses jobs with a network constraint without it -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- directBootAware: runs right after a reboot, before the first unlock -->
    <application android:label="ADB Keeper" android:allowBackup="false" android:directBootAware="true">
        <activity android:name=".Main" android:exported="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".Boot" android:exported="true" android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name=".KeepJob" android:exported="true" android:directBootAware="true" android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
