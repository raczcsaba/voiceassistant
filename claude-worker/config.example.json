{
  "listen": {
    "host": "0.0.0.0",
    "port": 8099
  },
  "secrets_dir": "/opt/voice/claude",
  "data_dir": "/opt/voice/claude/data",
  "timezone": "Europe/Budapest",
  "dry_run": false,
  "home_assistant": {
    "url": "http://HOME_ASSISTANT_HOST:8123",
    "token_file": "ha.token",
    "default_satellite": "assist_satellite.YOUR_SATELLITE",
    "jellyfin_play_path": "/api/jellyfin_panel/play",
    "jellyfin_play_device": "tv"
  },
  "music_assistant": {
    "url": "ws://MUSIC_ASSISTANT_HOST:8095/ws",
    "token_file": "ma.token",
    "playlist_provider": "tidal--YOUR_INSTANCE_ID",
    "default_player": "media_player.YOUR_DEFAULT_PLAYER",
    "player_aliases": {
      "media_player.YOUR_PLAYER": [
        "alias one",
        "alias two"
      ]
    },
    "player_hint": "the user calls them Kitchen, Living room or \"everywhere\" (a group of both)."
  },
  "jellyfin": {
    "url": "http://JELLYFIN_HOST:8096",
    "key_file": "jellyfin.key",
    "user": "YOUR_JELLYFIN_USER"
  },
  "anthropic": {
    "key_file": "anthropic.key",
    "model": "claude-sonnet-5-5",
    "allowed_models": [
      "claude-sonnet-5-5",
      "claude-haiku-5-5",
      "claude-opus-5-5"
    ],
    "effort": "low",
    "max_tokens": 4096,
    "web_search_tool": {
      "default": "web_search_20260209",
      "claude-haiku-5-5": "web_search_20250305"
    },
    "max_web_searches": 3,
    "web_search_location": null,
    "final_max_chars": 180
  },
  "limits": {
    "max_turns": 12,
    "max_seconds": 150,
    "max_task_usd": 0.6,
    "monthly_usd": 30.0
  },
  "status": {
    "min_gap_s": 6,
    "quiet_after_ack_s": 4,
    "max_per_task": 2,
    "idle_notice_s": 15,
    "idle_text": "Még dolgozom rajta.",
    "max_words": 6
  },
  "home_control": {
    "weather_entity": "weather.YOUR_WEATHER",
    "read_endpoints": {
      "jellyfin_now": {
        "path": "/api/jellyfin_panel/now?device=tv",
        "group": "tv"
      }
    },
    "readable": {
      "lights": [
        "switch.YOUR_LAMP",
        "light.YOUR_DIMMABLE_LIGHT"
      ],
      "tv": [
        "media_player.YOUR_TV"
      ],
      "speakers": [
        "media_player.YOUR_DEFAULT_PLAYER"
      ],
      "tablet": [
        "light.YOUR_TABLET_screen",
        "switch.YOUR_TABLET_screensaver_active",
        "input_select.YOUR_SAVER_STYLE"
      ],
      "weather": [
        "weather.YOUR_WEATHER",
        "sun.sun"
      ],
      "presence": [
        "person.YOUR_PERSON"
      ]
    },
    "actions": {
      "tv_on": {
        "description": "Turns the TV on (A tévé bekapcsolása).",
        "service": "script.turn_on",
        "data": {
          "entity_id": "script.YOUR_TV_WAKE"
        }
      },
      "tv_off": {
        "description": "Turns the TV off.",
        "service": "media_player.turn_off",
        "data": {
          "entity_id": "media_player.YOUR_TV"
        }
      },
      "tv_film_control": {
        "description": "Control the Jellyfin film on the TV.",
        "post": "/api/jellyfin_panel/control",
        "data": {
          "device": "tv"
        },
        "params": {
          "action": {
            "type": "string",
            "enum": [
              "playpause",
              "stop",
              "rewind",
              "forward"
            ],
            "required": true
          }
        }
      },
      "lights_on": {
        "description": "Lamps on: switch.YOUR_LAMP = LED lámpa, ...",
        "service": "homeassistant.turn_on",
        "params": {
          "entities": {
            "type": "entities",
            "enum": [
              "switch.YOUR_LAMP",
              "light.YOUR_DIMMABLE_LIGHT"
            ],
            "required": true,
            "as": "entity_id"
          }
        }
      },
      "lights_off": {
        "description": "Lamps off (same entities as lights_on).",
        "service": "homeassistant.turn_off",
        "params": {
          "entities": {
            "type": "entities",
            "enum": [
              "switch.YOUR_LAMP",
              "light.YOUR_DIMMABLE_LIGHT"
            ],
            "required": true,
            "as": "entity_id"
          }
        }
      },
      "light_brightness": {
        "description": "Brightness of a dimmable light.",
        "service": "light.turn_on",
        "params": {
          "entities": {
            "type": "entities",
            "enum": [
              "light.YOUR_DIMMABLE_LIGHT"
            ],
            "required": true,
            "as": "entity_id"
          },
          "brightness": {
            "type": "integer",
            "min": 1,
            "max": 100,
            "as": "brightness_pct",
            "required": true
          }
        }
      },
      "tablet_photos": {
        "description": "Photo slideshow (the user's own pictures) on the tablet: \"indítsd el a képeimet\".",
        "service": "script.turn_on",
        "data": {
          "entity_id": "script.YOUR_TABLET_SCREENSAVER",
          "variables": {
            "style": "Immich Photos"
          }
        }
      },
      "tablet_screensaver": {
        "description": "Tablet screensaver with a chosen wallpaper.",
        "service": "script.turn_on",
        "data": {
          "entity_id": "script.YOUR_TABLET_SCREENSAVER"
        },
        "params": {
          "style": {
            "type": "string",
            "enum": [
              "Immich Photos",
              "Live Sky",
              "Shuffle"
            ],
            "into": "variables"
          }
        }
      },
      "tablet_next_photo": {
        "description": "Next photo on the tablet screensaver.",
        "service": "button.press",
        "data": {
          "entity_id": "button.YOUR_TABLET_next_slide"
        }
      }
    },
    "manual": [
      "Rooms and devices with their Hungarian names, e.g. \"dekor lámpa\" = switch.YOUR_LAMP.",
      "Satellites: assist_satellite.YOUR_SATELLITE = the tablet; which device \"itt\" means.",
      "The default speaker, what each script does, words like \"képeim\" or \"vibe\"."
    ]
  },
  "seerr": {
    "url": "http://SEERR_HOST:5055",
    "key_file": "seerr.key",
    "user_id": 1,
    "notify_service": "notify.mobile_app_YOUR_PHONE",
    "poll_minutes": 5,
    "pending_seconds": 180,
    "quiet_start": 22,
    "quiet_end": 8,
    "dry_run": false
  },
  "catalogue": {
    "refresh_hours": 6,
    "max_artists": 600,
    "max_tracks": 600
  },
  "pricing": {
    "web_search_per_1000": 10.0,
    "models": {
      "claude-sonnet-5-5": {
        "input": 2.0,
        "cache_write_5m": 2.5,
        "cache_write_1h": 4.0,
        "cache_read": 0.1,
        "output": 10.0
      },
      "claude-haiku-5-5": {
        "input": 0.1,
        "cache_write_5m": 0.125,
        "cache_write_1h": 0.2,
        "cache_read": 0.01,
        "output": 0.5,
        "note": "prompts up to 100k tokens; above that 0.50/0.625/1.00/0.05/2.50"
      },
      "claude-opus-5-5": {
        "input": 4.0,
        "cache_write_5m": 5.0,
        "cache_write_1h": 8.0,
        "cache_read": 0.2,
        "output": 20.0
      }
    }
  }
}
