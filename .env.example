# Copy to .env and fill in the ones you want to test; backends without a key are skipped.
# Load with:  set -a; source .env; set +a
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Home Assistant (assistant.py --ha): base URL and a long-lived access token
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# ha_voice.py / voice_app.py: host:port of Home Assistant
HA_HOST=homeassistant.local:8123
